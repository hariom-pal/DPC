APP_NAME="ODPC Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Demonstration OTP — APP_ENV=local ONLY.
#
# On a demonstration machine there is no SMS gateway and no mail transport, so an
# OTP would reach only storage/logs/laravel.log, and only if a queue worker were
# running. In `local` the generated code is this value instead, so Department
# Registration can be completed on screen. The gate is the environment, not this
# line: setting DEMO_OTP on a UAT or production host does nothing at all.
DEMO_OTP=123456
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dpc_dev
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@cgpsc.gov.in"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ----------------------------------------------------------------------
# Feature Flags — external integrations (architect ruling, 2026-08-13)
# ----------------------------------------------------------------------
# Every integration defaults to OFF. The application runs and is fully
# demonstrable with all of them disabled; each has a defined fallback, so
# "disabled" never means "broken". Enabling one must require only these
# variables plus credentials — never a source-code change.
#
# See config/features.php, docs/integration/HRMS.md and
# docs/integration/CSC-DigiSign.md. Live state is visible to the CGPSC
# Admin at /admin/integrations.

FEATURE_HRMS=false
FEATURE_CSC_DIGISIGN=false
FEATURE_SMS_GATEWAY=false
FEATURE_EMAIL_GATEWAY=false
FEATURE_S3_STORAGE=false
FEATURE_LGD_SYNC=false
FEATURE_NOTIFICATIONS=true

# ----------------------------------------------------------------------
# Response security headers
# ----------------------------------------------------------------------
# The Content-Security-Policy is ENFORCED by default (TD-29, closed
# 2026-08-22): no view carries an inline script or event handler, and the
# repeating forms were driven in headless Chromium under the enforced
# policy before the default changed. `ViewsAreCspCleanTest` keeps it that
# way.
#
# Set DPC_CSP_ENFORCE=false to fall back to report-only without a deploy —
# the retreat a header that unexpectedly breaks a page needs. Point
# DPC_CSP_REPORT_URI at a collector to be told when a control has actually
# stopped working for somebody; unset, violations go nowhere.

DPC_SECURITY_HEADERS=true
DPC_CSP_ENFORCE=true
#DPC_CSP_REPORT_URI=
