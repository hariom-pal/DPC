APP_NAME="ODPC Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Fixed OTP — local, testing and UAT only (2026-10-26). Default off.
#
# Honoured only when APP_ENV is `local`, `testing` or `uat` AND the flag below is
# true. On production a configured fixed code is ignored and every OTP is random.
# DPC_OTP_FIXED_MOBILE=true makes the same code prove the mobile number (instead of
# a recorded waiver while there is no SMS gateway).
DPC_OTP_FIXED_ENABLED=true
DPC_OTP_FIXED_CODE=123456
DPC_OTP_FIXED_MOBILE=true
# Resend: a new code no sooner than this many seconds after the last, and at most
# this many codes per identifier per hour.
DPC_OTP_RESEND_COOLDOWN=60
DPC_OTP_MAX_SENDS_PER_HOUR=5

# Department Admin invitations and temporary passwords (2026-10-26).
DPC_INVITATION_TTL_HOURS=72
DPC_TEMPORARY_PASSWORD_LENGTH=16
DPC_PASSWORD_RESET_LIMIT_ACTOR=10
DPC_PASSWORD_RESET_LIMIT_TARGET=3
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dpc_dev
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# E-mail OTPs and Department Admin invitations need a working mail server on UAT
# and production: MAIL_MAILER=smtp with MAIL_HOST, MAIL_PORT, MAIL_SCHEME (smtps/null),
# MAIL_USERNAME, MAIL_PASSWORD and MAIL_FROM_ADDRESS. `log` writes mail — including
# OTPs — to the application log and is for local development only.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@cgpsc.gov.in"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ----------------------------------------------------------------------
# Feature Flags — external integrations (architect ruling, 2026-08-13)
# ----------------------------------------------------------------------
# Every integration defaults to OFF. The application runs and is fully
# demonstrable with all of them disabled; each has a defined fallback, so
# "disabled" never means "broken". Enabling one must require only these
# variables plus credentials — never a source-code change.
#
# See config/features.php, docs/integration/HRMS.md and
# docs/integration/CSC-DigiSign.md. Live state is visible to the CGPSC
# Admin at /admin/integrations.

FEATURE_HRMS=false
FEATURE_CSC_DIGISIGN=false
FEATURE_SMS_GATEWAY=false
FEATURE_EMAIL_GATEWAY=false
FEATURE_S3_STORAGE=false
FEATURE_LGD_SYNC=false
FEATURE_NOTIFICATIONS=true
FEATURE_UIDAI_AADHAAR_OTP=false
# UIDAI Aadhaar OTP over the CSC authentication API — read only when the flag
# above is true (see config/dpc.php, aadhaar_otp.uidai). Blank = default.
# UAT host https://cscauths.csccloud.in, production https://cscuidai.csccloud.in.
#CSC_AUTH_BASE_URL=https://cscauths.csccloud.in
#CSC_AUTH_ENDPOINT=aua/springboot/auth/req
# Issued by CSC. The token is also the AES key of req_hash (16 or 32 chars).
CSC_AUTH_CLIENT_ID=
CSC_AUTH_TOKEN=
#CSC_AUTH_TIMEOUT_SECONDS=30
# 0 = never re-send (a re-sent OTP request may text twice; a re-sent Auth is 563).
#CSC_AUTH_RETRY_ATTEMPTS=0
#CSC_AUTH_VERIFY_RESPONSE_HASH=true
# UIDAI ac / sa / lk — blank until CSC confirms (wrong values: 530/531/543).
DPC_UIDAI_AUA_CODE=
DPC_UIDAI_SUB_AUA_CODE=
DPC_UIDAI_LICENCE_KEY=
# Path to UIDAI's public ENCRYPTION certificate (PEM) for UAT or production.
DPC_UIDAI_ENCRYPTION_CERTIFICATE=
# txn prefix: letters/digits, must not start with "U" (UIDAI error 587).
#DPC_UIDAI_TXN_PREFIX=DPC
#DPC_UIDAI_API_VERSION=2.5

# ----------------------------------------------------------------------
# Response security headers
# ----------------------------------------------------------------------
# The Content-Security-Policy is ENFORCED by default (TD-29, closed
# 2026-08-22): no view carries an inline script or event handler, and the
# repeating forms were driven in headless Chromium under the enforced
# policy before the default changed. `ViewsAreCspCleanTest` keeps it that
# way.
#
# Set DPC_CSP_ENFORCE=false to fall back to report-only without a deploy —
# the retreat a header that unexpectedly breaks a page needs. Point
# DPC_CSP_REPORT_URI at a collector to be told when a control has actually
# stopped working for somebody; unset, violations go nowhere.

DPC_SECURITY_HEADERS=true
DPC_CSP_ENFORCE=true
#DPC_CSP_REPORT_URI=
